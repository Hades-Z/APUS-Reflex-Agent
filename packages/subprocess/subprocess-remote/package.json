{
  "name": "@deepseek-ai/dsh-subprocess-remote",
  "description": "Subprocess runtime that runs each command in the task container a benchmark owns",
  "version": "0.1.7-rc.2",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepseek-ai/deepseek-harness.git",
    "directory": "packages/subprocess/subprocess-remote"
  },
  "type": "module",
  "main": "lib/index.js",
